{
  "extends": "../../tsconfig.base.json",
  "exclude": ["node_modules", "build", "dist", ".next", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx"
  ],
  "references": [
    {
      "path": "../../lib/api-zod"
    },
    {
      "path": "../../lib/api-client-react"
    },
    {
      "path": "../../lib/royal-equine-catalogue"
    },
    {
      "path": "../../lib/royal-equine-server"
    }
  ]
}
